{
  "expo": {
    "name": "coop-feeder",
    "slug": "coop-feeder",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/superchicken.png",
    "scheme": "coopfeeder",
    "userInterfaceStyle": "automatic",
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/superchicken.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.wjquigs.coopfeeder"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-notifications",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/icon.png",
          "imageWidth": 76
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "7cd2f5aa-5f7c-46d8-be71-c8daa4712c9b"
      }
    }
  }
}
